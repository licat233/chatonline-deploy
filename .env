COMPOSE_PROJECT_NAME: 'chatonline'
PROJECT_NAME: '快言'

# base
TZ: 'Asia/Shanghai'
EXTERNAL_IP: '192.168.101.2'

# 域名
DOMAIN: 'chat233.cc'

# minio
MINIO_ROOT_USER: 'minio'   # minio的用户名
MINIO_ROOT_PASSWORD: 'qwertyuiop' # minio的密码，随机字符串即可
MINIO_SERVER_URL: ''  # MINIO_SERVER_URL
MINIO_BROWSER_REDIRECT_URL: '' # MINIO_BROWSER_REDIRECT_URL

# mysql
MYSQL_ROOT_PASSWORD: 'qwertyuiop'  # 数据库的密码 随机字符串即可
MYSQL_DATABASE: 'im' # 数据名称 建议用默认的im

## web
WEB_PORT: 3000

# redis
REDIS_MANAGE_USERNAME: 'admin'
REDIS_MANAGE_PASSWORD: 'qwertyuiop'

# im
WK_MODE: 'debug' # debug or release

# server
TS_MODE: 'debug' # debug or release
TS_SMSCODE: '123456'  # 手机注册默认的短信验证码
TS_FILESERVICE: 'minio' # File service type, default is minio
# HOST: 'api.chat233.cc'
API_URL: 'http://192.168.101.2:8090' # API地址 例如：http://xxx.xxx.x.xx:8090/  xxx.xxx.x.xx 为服务器IP地址

# nginx
NGINX_HTTP_PORT: '12080'
NGINX_HTTPS_PORT: '12443'

NGINX_USERNAME: 'licat'  # 内网 Nginx 网关用户名
# 内网 Nginx 网关密码明文：licat233
# 使用 htpasswd 工具，加密命令：htpasswd -nb licat licat233
NGINX_PASSWORD: '$apr1$WBCC0Vn6$rqyAkV6M/T4WLUxKfWj/71'
